# =====================================================================
# Asset Management Assistant — single configuration control panel
# Copy to `.env` and fill in. Every knob below is optional except
# OLLAMA_API_KEY. Two naming styles both work:
#   flat alias:     LLM_MODEL=gemma4:31b-cloud
#   nested (__):    LLM__MAX_CONCURRENCY=3
# =====================================================================

# ---- LLM / Ollama Cloud (OLLAMA_API_KEY is REQUIRED) ----------------
OLLAMA_API_KEY=your-ollama-cloud-key-here
OLLAMA_HOST=https://ollama.com
LLM_MODEL=gemma4:31b-cloud
# Ollama Cloud concurrency: Free=1, Pro=3, Max=10. Raising this unlocks
# parallel sub-agent calls in Backend 2 with no code change.
LLM__MAX_CONCURRENCY=1
LLM__TIMEOUT_SECONDS=120

# ---- Backend 1: ReAct agent ----------------------------------------
AGENT__MAX_STEPS=6

# ---- Database ------------------------------------------------------
# engine: 'sqlite' (Backends 1 & 2) or 'duckdb' (Backend 3 analytical path)
DB__ENGINE=sqlite
DB__MAX_QUERY_ROWS=50
# DB_PATH / ASSETS_CSV / USERS_DB_PATH default under ./data — override if needed.

# ---- Auth (shared JWT) ---------------------------------------------
JWT_SECRET=change-me-in-production-please
JWT__ALGORITHM=HS256
JWT__EXPIRY_MINUTES=120

# ---- Backend 2: LangGraph supervisor -------------------------------
# When true AND LLM__MAX_CONCURRENCY>1, independent workers run in parallel;
# otherwise sequential through the semaphore. Same code path.
SUPERVISOR__PARALLEL_WORKERS=true
SUPERVISOR__MAX_ROUTING_STEPS=4

# ---- Backend 3: intent router --------------------------------------
ROUTER__MAX_CHAINED_INTENTS=3

# ---- Ports (Streamlit talks to these) ------------------------------
PORT__REACT=8001
PORT__SUPERVISOR=8002
PORT__ROUTER=8003
